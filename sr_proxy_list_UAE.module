# ----------------------------------------------------------------------------
#  IP-CIDR SERVER MEDIA (RTP/STUN/TURN) — BẮT BUỘC để cuộc gọi không rớt
# ----------------------------------------------------------------------------
# --- Meta (WhatsApp / Messenger / Instagram), AS32934 ---
IP-CIDR,31.13.24.0/21,PROXY,no-resolve
IP-CIDR,31.13.64.0/18,PROXY,no-resolve
IP-CIDR,45.64.40.0/22,PROXY,no-resolve
IP-CIDR,66.220.144.0/20,PROXY,no-resolve
IP-CIDR,69.63.176.0/20,PROXY,no-resolve
IP-CIDR,69.171.224.0/19,PROXY,no-resolve
IP-CIDR,74.119.76.0/22,PROXY,no-resolve
IP-CIDR,102.132.96.0/20,PROXY,no-resolve
IP-CIDR,129.134.0.0/16,PROXY,no-resolve
IP-CIDR,157.240.0.0/16,PROXY,no-resolve
IP-CIDR,173.252.64.0/18,PROXY,no-resolve
IP-CIDR,179.60.192.0/22,PROXY,no-resolve
IP-CIDR,185.60.216.0/22,PROXY,no-resolve
IP-CIDR,204.15.20.0/22,PROXY,no-resolve
IP-CIDR6,2a03:2880::/32,PROXY,no-resolve
# --- Apple (FaceTime/iMessage relay) — cả 17.0.0.0/8 là của Apple.
#     Nếu thấy App Store/iCloud chậm, có thể bỏ dòng này (FaceTime vẫn cần nó). ---
IP-CIDR,17.0.0.0/8,PROXY,no-resolve
# --- Telegram (cuộc gọi nối datacenter/reflector bằng IP) ---
IP-CIDR,91.108.4.0/22,PROXY,no-resolve
IP-CIDR,91.108.8.0/22,PROXY,no-resolve
IP-CIDR,91.108.12.0/22,PROXY,no-resolve
IP-CIDR,91.108.16.0/22,PROXY,no-resolve
IP-CIDR,91.108.20.0/22,PROXY,no-resolve
IP-CIDR,91.108.56.0/22,PROXY,no-resolve
IP-CIDR,95.161.64.0/20,PROXY,no-resolve
IP-CIDR,149.154.160.0/20,PROXY,no-resolve
IP-CIDR,149.154.164.0/22,PROXY,no-resolve
IP-CIDR6,2001:67c:4e8::/48,PROXY,no-resolve
IP-CIDR6,2001:b28:f23c::/48,PROXY,no-resolve
IP-CIDR6,2001:b28:f23d::/48,PROXY,no-resolve
IP-CIDR6,2001:b28:f23f::/48,PROXY,no-resolve

